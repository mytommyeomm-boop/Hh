-- TOTAL — ใช้ได้ทั้ง server/client (อ่าน attribute)
-- ═══════════════════════════════════════════════════════════════════════
function LuckMega.total(player)
    if not (player and player.Parent) then return CFG.BASE_LUCK end
    if player:GetAttribute("BossFight") then return 1 end

    local p = player

    -- Multipliers
    local mult = 1
    local function m(v) if v and v > 1 then mult = mult * v end end
    m(math.max(p:GetAttribute(ATTR.LUCK) or 1, p:GetAttribute(ATTR.DONOR_LUCK) or 1))
    m(p:GetAttribute(ATTR.POTION_LUCK))
    m(p:GetAttribute(ATTR.ADMIN_LUCK))
    m(p:GetAttribute(ATTR.EVENT_LUCK))
    m(p:GetAttribute(ATTR.CHARM_MULT))
    m(p:GetAttribute(ATTR.GEM_MULT))
    m(p:GetAttribute(ATTR.GROUP_MULT))
    m(p:GetAttribute(ATTR.PREMIUM_MULT))
    m(p:GetAttribute(ATTR.COSMIC_MULT))
    m(p:GetAttribute(ATTR.HEAT_MULT))
    m(workspace:GetAttribute(ATTR.SERVER_LUCK))
    if mult < 1 then mult = 1 end

    -- Flats
    local flat = 0
    local function f(v) if v and v > 0 then flat = flat + v end end
    f(p:GetAttribute(ATTR.TRAIT_LUCK))
    f(p:GetAttribute(ATTR.QUEST_LUCK))
    f(p:GetAttribute(ATTR.POTION_LUCK_ADD))
    f(p:GetAttribute(ATTR.CHARM_FLAT))
    f(p:GetAttribute(ATTR.FRIENDS_FLAT))
    f(p:GetAttribute(ATTR.TIME_BONUS))

    if (p:GetAttribute(ATTR.PITY_COUNT) or 0) >= CFG.PITY_THRESHOLD then
        f(CFG.PITY_BONUS)
    end

    local st = p:GetAttribute(ATTR.STREAK_COUNT) or 0
    f(math.min(st, CFG.STREAK_MAX) * CFG.STREAK_PER)

    local day = p:GetAttribute(ATTR.DAILY_DAY) or 0
    if day > 0 then
        f(CFG.DAILY_BONUS[math.min(day, #CFG.DAILY_BONUS)] or 0)
    end

    local pt = (p:GetAttribute(ATTR.PLAYTIME) or 0) / 3600
    f(math.min(pt * CFG.PLAYTIME_PER_HOUR, CFG.PLAYTIME_MAX))

    f(math.min(p:GetAttribute(ATTR.KILLSTREAK) or 0, CFG.KILLSTREAK_MAX) * CFG.KILLSTREAK_PER)
    f(math.min(p:GetAttribute(ATTR.ACH_COUNT) or 0, CFG.ACH_MAX))

    if (mult + flat) < CFG.LOW_LUCK_THRESHOLD then
        f(CFG.LOW_LUCK_BONUS)
    end

    return math.min(mult + flat, CFG.MAX_LUCK)
end

-- ═══════════════════════════════════════════════════════════════════════
-- FILTER — ตัดของกาก (ใช้ได้ทั้ง 2 ฝั่ง)
-- ═══════════════════════════════════════════════════════════════════════
function LuckMega.filterPool(pool)
    if type(pool) ~= "table" then return {} end
    local F = CFG.FILTER

    local black = {}
    for _, n in F.BLACKLIST do black[n] = true end

    local white = nil
    if #F.WHITELIST > 0 then
        white = {}
        for _, n in F.WHITELIST do white[n] = true end
    end

    local out = {}
    for _, atk in pool do
        if type(atk) ~= "table" or not atk.Name then continue end

        local keep
        if white then
            keep = white[atk.Name] == true
        else
            local c = tonumber(atk.Chance) or 0
            keep = c >= F.MIN_CHANCE
            if black[atk.Name] then keep = false end
        end

        if keep then
            local copy = table.clone(atk)
            if F.RARE_BOOST then
                local c = tonumber(copy.Chance) or 0
                if c >= F.RARE_BOOST_FROM then
                    copy.Chance = c * F.RARE_BOOST_MULT
                end
            end
            out[#out+1] = copy
        end
    end
    return out
end

function LuckMega.weightedRoll(pool, luck)
    luck = tonumber(luck) or 1
    if #pool == 0 then return nil end

    local total, weights = 0, {}
    for i, atk in pool do
        local c = math.max(tonumber(atk.Chance) or 1, 1)
        local w = (1 / c) * luck
        weights[i] = w
        total = total + w
    end

    local r = math.random() * total
    local acc = 0
    for i, w in weights do
        acc = acc + w
        if r <= acc then return pool[i] end
    end
    return pool[#pool]
end

